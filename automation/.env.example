# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# ".env" wird NIE committed (siehe .gitignore) — echte Zugangsdaten bleiben nur lokal.

# ── Welo / SuCi-Net ──────────────────────────────────────────────────────
# Persönlicher CSV-Export-Link aus: Statistiken > Statistik Exporter
# Wie ein Passwort behandeln — niemals teilen, niemals committen.
WELO_STATISTIK_URL=

# Login für sync-welo-personal.js (Playwright-Login, Session-Cookie-Auth —
# nach Möglichkeit ein eigenes Automation-Konto statt des persönlichen).
WELO_BASE_URL=https://welo.sushi-circle.de
WELO_USER=
WELO_PASSWORD=
# Ziel-Faktor für die tägliche Umsatz-Zielvorgabe (Vorjahrestag × Faktor).
# 1.25 = "Vorjahresumsatz + 25 %", per t.duong am 02.09.2026 festgelegt.
WELO_ZIEL_FAKTOR=1.25

# ── Axonity ERP ──────────────────────────────────────────────────────────
# Nach Möglichkeit ein eigenes Automation-Konto anlegen statt des
# persönlichen Kontos.
# Domain seit ca. 02.09.2026 auf sck.sushi-circle.de umgezogen (erp.axonity.de
# leitet zwar noch weiter, aber über einen zusätzlichen, unzuverlässigen Hop
# — darum direkt die neue Domain eintragen).
AXONITY_BASE_URL=https://sck.sushi-circle.de
AXONITY_USER=
AXONITY_PASSWORD=

# ── Firebase ──────────────────────────────────────────────────────────────
# Firebase Console > Projekteinstellungen > Dienstkonten > Neuen privaten
# Schlüssel generieren. Die JSON-Datei NICHT committen.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=glsc-eabb6
