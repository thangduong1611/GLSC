# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# ".env" wird NIE committed (siehe .gitignore) — echte Zugangsdaten bleiben nur lokal.

# ── Welo / SuCi-Net ──────────────────────────────────────────────────────
# Persönlicher CSV-Export-Link aus: Statistiken > Statistik Exporter
# Wie ein Passwort behandeln — niemals teilen, niemals committen.
WELO_STATISTIK_URL=

# ── Axonity ERP ──────────────────────────────────────────────────────────
# Nach Möglichkeit ein eigenes Automation-Konto anlegen statt des
# persönlichen Kontos.
AXONITY_BASE_URL=https://erp.axonity.de
AXONITY_USER=
AXONITY_PASSWORD=

# ── Firebase ──────────────────────────────────────────────────────────────
# Firebase Console > Projekteinstellungen > Dienstkonten > Neuen privaten
# Schlüssel generieren. Die JSON-Datei NICHT committen.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=glsc-eabb6
