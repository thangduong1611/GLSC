  "description": "Scheduled jobs that sync branch Umsatz (Welo/SuCi-Net) and Produktionszeiten (Axonity) into the GLSC Firestore project for the Filial Radar dashboard.",
  "type": "commonjs",
  "scripts": {
    "sync:umsatz": "cross-env NODE_EXTRA_CA_CERTS=./certs/globalsign-gcc-r6-alphassl-ca-2025.pem node src/sync-welo-umsatz.js",
    "sync:produktion": "node src/sync-axonity-produktion.js",
    "sync:bestellungen": "node src/sync-axonity-bestellungen.js",
    "sync:welo-personal": "cross-env NODE_EXTRA_CA_CERTS=./certs/globalsign-gcc-r6-alphassl-ca-2025.pem node src/sync-welo-personal.js",
