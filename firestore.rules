rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════
    // AUTH HELPERS
    // ══════════════════════════════════════════════════════════
    function isAuthed() {
      return request.auth != null;
    }
    // Regions the signed-in email is a manager of, e.g. ['ost'] or ['ost','west'].
    // Looked up from managers/{email}. Firestore caches identical get()/exists()
    // calls within one rule evaluation, so this doesn't multiply per document
    // returned by a list query.
    function managerRegions() {
      return isAuthed() && exists(/databases/$(database)/documents/managers/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/managers/$(request.auth.token.email)).data.regions
        : [];
    }
    // Any-region manager — used for collections shared across all regions
    // (Mitteilungen, globale Einstellungen, Inventur-Produktkatalog).
    function isManager() {
      return managerRegions().size() > 0;
    }
    // Region-scoped manager — used for collections that must stay separated
    // per region (Mitarbeiter, Krankmeldung, Belege, Wareneingang, Umlagerung,
    // Urlaub, Änderungsvereinbarung, Filialen).
    function isManagerForRegion(r) {
      return r in managerRegions();
    }
    // Existing docs written before the Region-Feature (or any future doc that
    // somehow lacks a region) are treated as "ost" for access purposes — this
    // is what lets a manager (and the one-time Backfill) read/update/delete
    // pre-migration data at all. Once the Backfill has run, every document
    // has an explicit region and this fallback is never actually used.
    function docRegion(data) {
      return data.get('region', 'ost');
    }
    // Mitarbeiter melden sich seit der PIN-Anmeldung (automation/src/employee-auth.js)
    // mit einem Custom Token an, dessen uid `emp_<Personalnummer>` lautet und das
    // einen Claim `pid` mit genau dieser Personalnummer trägt — das bindet ihre
    // Firebase-Identität an GENAU eine Personalnummer. Vorher war jeder
    // Mitarbeiter-Login rein anonym (irgendein Nutzer ist angemeldet, aber
    // welcher, ließ sich serverseitig nicht prüfen) — jede beliebige Personalnummer
    // konnte für Schreibvorgänge vorgetäuscht werden. Eine alte, vor diesem Update
    // signierte anonyme Sitzung hat keinen pid-Claim und fällt hier auf null/false
    // zurück — das ist beabsichtigt, sie muss sich einmal neu anmelden.
    function ownPid() {
      return isAuthed() ? request.auth.token.get('pid', null) : null;
    }
    function isOwnEmp(empId) {
      return ownPid() != null && ownPid() == empId;
    }

    // ══════════════════════════════════════════════════════════
    // REGION-MAPPING (new)
    // ══════════════════════════════════════════════════════════
    // Grants are set manually via Firebase Console — no in-app UI writes here.
    match /managers/{email} {
      allow get: if isAuthed() && request.auth.token.email == email;
      allow write: if false;
    }

    // Anzeigename je Region (z.B. 'ost' -> 'Đông') — Daten statt Code, damit
    // eine neue Region künftig ohne Code-Änderung nutzbar ist: es reicht,
    // hier einen Doc + einen managers/{email}-Eintrag anzulegen.
    match /regions/{slug} {
      // "get" auch für Mitarbeiter (isAuthed) — mitarbeiter.html liest hier
      // die urlaubRules der eigenen Region direkt, um dieselben Regeln
      // clientseitig zu prüfen wie der Gebietsleiter in index.html einträgt.
      // "list" bleibt Manager-only (kein Anwendungsfall für Mitarbeiter, und
      // verhindert das Durchzählen aller Regionen).
      allow get: if isAuthed();
      allow list: if isManager();
      // Ein Manager darf nur urlaubRules seiner EIGENEN Region ändern — label/
      // syncUrl bleiben admin-only (per Skript gesetzt, siehe regions/{slug}
      // Kommentar weiter oben im Projekt).
      allow update: if isManagerForRegion(slug)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['urlaubRules']);
      allow create, delete: if false;
    }

    // ══════════════════════════════════════════════════════════
    // FILIALEN-STAMMDATEN (new — replaces the old browser-local-only lists)
    // ══════════════════════════════════════════════════════════
    match /filialen_meta/{marktNr} {
      allow get, list: if isAuthed();
      allow create: if isManagerForRegion(request.resource.data.region);
      allow update: if isManagerForRegion(docRegion(resource.data))
        && isManagerForRegion(request.resource.data.region);
      allow delete: if isManagerForRegion(docRegion(resource.data));
    }

    // ══════════════════════════════════════════════════════════
    // MITARBEITERSTAMMDATEN
    // ══════════════════════════════════════════════════════════
    // get/list stay open to any authenticated (incl. anonymous employee)
    // session — employee-side login/roster lookups rely on this and cannot
    // be region-gated server-side since employee auth carries no identity
    // claim. Region separation for employee-facing reads (e.g. Umlagerung's
    // "welche Filiale" list) is enforced client-side via query filters.
    match /emps/{pid} {
      allow get, list: if isAuthed();
      allow create: if isManagerForRegion(request.resource.data.region);
      allow update: if isManagerForRegion(docRegion(resource.data))
        && isManagerForRegion(request.resource.data.region);
      allow delete: if isManagerForRegion(docRegion(resource.data));
    }

    // ══════════════════════════════════════════════════════════
    // DIENSTPLAN — unchanged, already scoped per-Filiale by doc ID
    // ══════════════════════════════════════════════════════════
    match /plan/{docId} {
      allow read, write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════
    // GLOBALE KONFIGURATION — shared across regions, any manager
    // ══════════════════════════════════════════════════════════
    match /meta/{docId} {
      allow get: if isAuthed();
      allow list, write: if isManager();
    }

    // ══════════════════════════════════════════════════════════
    // URLAUB
    // ══════════════════════════════════════════════════════════
    // update: Manager der zustaendigen Region; ODER der Mitarbeiter korrigiert die Daten
    // seines eigenen, noch nicht entschiedenen Antrags (statt einen zweiten zu stellen).
    // Der Status muss dabei "pending" bleiben — niemand kann sich selbst genehmigen —
    // und ausser from/to/updated darf kein Feld angefasst werden.
    match /filialen/{f}/urlaub/{u} {
      allow read: if isAuthed();
      allow create: if isOwnEmp(request.resource.data.empId);
      allow update: if isManagerForRegion(docRegion(resource.data))
        || (isOwnEmp(resource.data.empId)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['from', 'to', 'updated']));
      allow delete: if isManagerForRegion(docRegion(resource.data));
    }
    match /{path=**}/urlaub/{u} {
      // list() auf einer collectionGroup kann Firestore nur dann gegen ein
      // dynamisches Feld wie region prüfen, wenn die Query selbst ein
      // passendes .where('region','==',...) mitbringt (sonst wird die ganze
      // Anfrage abgelehnt, nicht nur gefiltert). fbStartPending() tut das
      // bereits (collectionGroup('urlaub').where('region','==',activeRegion)),
      // daher ist die Region-Prüfung hier sicher scharf zu stellen.
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
    }

    // ══════════════════════════════════════════════════════════
    // MITTEILUNGEN — stays company-wide across regions (by design)
    // ══════════════════════════════════════════════════════════
    match /news/{n} {
      allow read: if isAuthed();
      allow write: if isManager();
    }
    match /news_reads/{id} {
      allow read, write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════
    // KRANKMELDUNG / URLAUBSANTRAG (Antrag-Paket)
    // ══════════════════════════════════════════════════════════
    match /krank/{k} {
      allow create: if isOwnEmp(request.resource.data.empId);
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow update, delete: if isManagerForRegion(docRegion(resource.data));
    }
    match /antrag/{a} {
      // Feld heißt hier "id", nicht "empId" (siehe maSendAntrag in mitarbeiter.html).
      // Zwei Wege zur Entstehung: Mitarbeiter meldet selbst (isOwnEmp, kein status-Feld)
      // ODER Gebietsleiter legt ihn mit status:'sent_by_hr' an (uSendAntragToEmployee in
      // index.html) — dort schreibt der Manager, nicht der Mitarbeiter (Auftrag t.duong
      // 09.09.2026: Mitarbeiter soll auch von HR eingetragenen Urlaub gegenzeichnen können).
      // isOwnEmp-Zweig ohne status-Feld halten (wie maSendAntrag es immer schon tut) —
      // sonst könnte ein Mitarbeiter sich selbst einen status:'sent_by_hr'-Antrag anlegen
      // und so vorgaukeln, der Gebietsleiter hätte ihn geschickt.
      allow create: if (isOwnEmp(request.resource.data.id) && !('status' in request.resource.data))
        || (isManagerForRegion(request.resource.data.region) && request.resource.data.status=='sent_by_hr');
      allow get: if isManagerForRegion(docRegion(resource.data));
      // list: Manager sieht alle Anträge seiner Region; ein Mitarbeiter darf nur nach
      // seiner eigenen id abfragen (so wie ulhrStartListener in mitarbeiter.html es tut) —
      // Firestore prüft das anhand des .where('id','==',...)-Filters der Anfrage selbst.
      allow list: if isManagerForRegion(resource.data.region) || isOwnEmp(resource.data.id);
      // Der Mitarbeiter darf einen vom Gebietsleiter gesendeten Antrag gegenzeichnen —
      // aber nur den Übergang sent_by_hr → signed, und nur die eigenen Unterschrift-Felder.
      allow update: if isManagerForRegion(docRegion(resource.data))
        || (isOwnEmp(resource.data.id)
            && resource.data.status == 'sent_by_hr'
            && request.resource.data.status == 'signed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status','einsatz','ruf','anOrtDatum','anSig','signedAt']));
      allow delete: if isManagerForRegion(docRegion(resource.data));
    }

    // ══════════════════════════════════════════════════════════
    // BELEGE (Hóa đơn hoàn ứng)
    // create: jeder eingeloggte Mitarbeiter
    // read:   jeder eingeloggte Mitarbeiter (für "Meine Belege", client-seitig gefiltert)
    // update: Manager der zuständigen Region; oder Mitarbeiter bestätigt selbst
    //         den Erhalt (paid -> confirmed), keine anderen Felder änderbar
    // delete: nur Manager der zuständigen Region
    // ══════════════════════════════════════════════════════════
    match /receipts/{k} {
      allow create: if isOwnEmp(request.resource.data.empId);
      allow read: if isAuthed();
      allow update: if isManagerForRegion(docRegion(resource.data))
        || (isOwnEmp(resource.data.empId)
            && resource.data.status == 'paid'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'confirmedAt', 'empHidden']));
      allow delete: if isManagerForRegion(docRegion(resource.data));
    }

    // ══════════════════════════════════════════════════════════
    // ÄNDERUNGSVEREINBARUNG
    // (Konsolidiert — die Live-Regeln hatten zuvor zwei überlappende
    // match-Blöcke für denselben Pfad; hier zu einem klaren zusammengeführt.)
    // ══════════════════════════════════════════════════════════
    match /aenderungsvertrag/{a} {
      allow create: if isManagerForRegion(request.resource.data.region);
      allow read: if isAuthed();
      allow update: if isManagerForRegion(docRegion(resource.data))
        || (isOwnEmp(resource.data.empId)
            && resource.data.status == 'sent'
            && request.resource.data.status == 'signed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'anOrt', 'anSig', 'signedAt']));
      allow delete: if isManagerForRegion(docRegion(resource.data));
    }

    // ══════════════════════════════════════════════════════════
    // WARENEINGANG-REKLAMATION
    // ══════════════════════════════════════════════════════════
    match /wareneingang/{w} {
      allow create: if isOwnEmp(request.resource.data.empId);
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow update, delete: if isManagerForRegion(docRegion(resource.data));
    }

    // ══════════════════════════════════════════════════════════
    // UMLAGERUNG
    // ══════════════════════════════════════════════════════════
    match /umlagerung/{u} {
      allow create: if isOwnEmp(request.resource.data.empId);
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow update, delete: if isManagerForRegion(docRegion(resource.data));
    }

    // ══════════════════════════════════════════════════════════
    // INVENTUR
    // config/photos/storemap = geteilter Produktkatalog (165 Artikel, Kategorien,
    // Fotos, Markt-Nr.->Name-Verzeichnis) — bewusst regionsübergreifend, dieselben
    // physischen Artikel für Ost und West.
    // period/links/counts = Betriebsdaten pro Filiale/Monat — SEIT der Inventur-
    // Region-Trennung app-seitig nach region gefiltert/getaggt (Dokument-ID bei
    // period/links jetzt "{month}__{region}"; counts trägt ein region-Feld).
    // Regeln bleiben bewusst offen (isAuthed statt isManagerForRegion): Mitarbeiter
    // schreiben ihre eigene Zählung wiederholt über eine anonyme Session ohne
    // stabile Identität — dieselbe Vertrauensbasis wie bei emps/filialen_meta
    // get/list. Die Trennung passiert über den Dokument-ID/Feld-Filter, nicht die Regel.
    // ══════════════════════════════════════════════════════════
    match /inventur_config/{id} {
      allow read: if isAuthed();
      allow write: if isManager();
    }
    match /inventur_photos/{art} {
      allow read, write: if isAuthed();
    }
    match /inventur_period/{id}   { allow read, write: if isAuthed(); }
    match /inventur_links/{id}    { allow read, write: if isAuthed(); }
    match /inventur_storemap/{id} { allow read, write: if isAuthed(); }
    match /inventur_counts/{id}   { allow read, write: if isAuthed(); }

    // Welo-Abgleich-Vorschau (sync-inventur-diff.js/sync-inventur-apply.js) —
    // anders als die Collections oben nur für Manager sichtbar (enthält
    // Mengen-Abweichungen, kein Mitarbeiter-Anwendungsfall dafür) und nur per
    // Admin-SDK beschrieben, genau wie die Filial-Radar-Collections unten.
    match /inventur_welo_preview/{id} {
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow write: if false;
    }

    // Wochen-Abgleich Urlaub/Krankmeldung vs. Welo (sync-week-welo-check.js) —
    // 1 Dok. pro Region (docId = Region), bei jedem Lauf komplett überschrieben.
    // Nur Manager, nur per Admin-SDK beschrieben — gleiches Muster wie oben.
    match /welo_week_check/{region} {
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow write: if false;
    }

    // Wareneingang → Schwan-Reklamation-Assistent (sync-schwan-lookup.js /
    // sync-schwan-submit.js). Der Manager darf NUR sein eigenes Auftrag/
    // Artikel-Review als confirmedSelection eintragen — alles andere
    // (Vorschau-Daten, Status) kommt ausschließlich per Admin-SDK von den
    // Skripten, damit ein Feld-Tippfehler im Client nie versehentlich die
    // Vorschau selbst verfälscht.
    match /schwan_matches/{id} {
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow update: if isManagerForRegion(docRegion(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedSelection']);
      allow create, delete: if false;
    }

    // Audit-Log für den Manager-Schnellzugriff "Als Mitarbeiter ansehen"
    // (server.js: /internal/impersonate-employee) — nur vom Server per Admin-SDK
    // geschrieben, Manager können ihre eigene Region einsehen.
    match /manager_impersonation_log/{id} {
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════
    // FILIAL RADAR — Umsatz (Welo) + Produktionszeiten (Axonity),
    // regionsübergreifend. Nur vom Automation-Skript per Admin-SDK
    // beschrieben (Service-Account umgeht diese Regeln) — Client-Writes
    // sind daher bewusst gesperrt.
    // ══════════════════════════════════════════════════════════
    // Manager-only (keine mitarbeiter.html-Zugriffe) — seit der Mehr-Konten-
    // Unterstützung tragen alle Schreibvorgänge ein region-Feld (siehe
    // resolveRegion() in automation/src/branches.js), daher hier sowohl
    // get als auch list region-scharf.
    match /filiale_umsatz/{docId} {
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow write: if false;
    }
    // Live-Tagesumsatz: wird auch von der Mitarbeiter-App gelesen
    // (maRenderZielInfo, Fortschrittsbalken zum Tagesziel), nicht nur vom
    // Manager-Dashboard - deshalb bleibt get() isAuthed() wie bei
    // tagesziel/emp_welo unten (Mitarbeiter-Login ist anonym, kann serverseitig
    // nicht regionsgebunden geprüft werden); list() ist aber nur fürs
    // Manager-Dashboard und daher region-scharf.
    match /filiale_produktion/{docId} {
      allow get: if isAuthed();
      allow list: if isManagerForRegion(resource.data.region);
      allow write: if false;
    }
    match /filiale_bestellungen/{docId} {
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow write: if false;
    }
    // Gesundheitsstatus der Axonity/Welo-Sync-Skripte selbst (ok/warn/error
    // je Skript) — getrennt von den Datencollections oben, damit das
    // Dashboard "Sync kaputt" anzeigen kann statt nur veraltete Zahlen.
    match /sync_status/{docId} {
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow list: if isManagerForRegion(resource.data.region);
      allow write: if false;
    }

    // Mitarbeiter-Selbstauskunft (Soll-Std./Urlaub/Krank aus Welo) + tägliches
    // Umsatz-Ziel je Filiale — anders als die drei Collections oben müssen
    // Mitarbeiter (nicht nur Manager) das per get() lesen können, um ihre
    // eigenen Werte bzw. das Tagesziel ihrer Filiale zu sehen (anonymer
    // Mitarbeiter-Login, serverseitig nicht regionsgebunden prüfbar). list()
    // ist nur fürs Manager-Dashboard und daher region-scharf. Nur vom
    // sync-welo-personal.js-Skript per Admin-SDK beschrieben.
    match /emp_welo/{docId} {
      allow get: if isAuthed();
      allow list: if isManagerForRegion(resource.data.region);
      allow write: if false;
    }
    match /tagesziel/{docId} {
      allow get: if isAuthed();
      allow list: if isManagerForRegion(resource.data.region);
      allow write: if false;
    }

    // Manueller "Jetzt aktualisieren"-Knopf im Dashboard: Manager darf ein
    // Trigger-Dokument schreiben, ein dauerhaft laufendes Watcher-Skript auf
    // dem Automation-Rechner sieht es (onSnapshot) und stößt die drei
    // Sync-Skripte an — Ersatz/Ergänzung zu den zeitgesteuerten Tasks, falls
    // der PC gerade an ist statt zur festen Uhrzeit.
    match /sync_triggers/{id} {
      // Doc-ID ist seit der Mehr-Konten-Unterstützung region-suffixt
      // ('manual__<region>', siehe watch-and-sync.js/server.js) und trägt ein
      // region-Feld — ohne das könnte ein Manager einer Region den laufenden
      // Sync-Trigger einer anderen Region auslösen oder dessen Fortschritt lesen.
      allow get: if isManagerForRegion(docRegion(resource.data));
      allow create: if isManagerForRegion(request.resource.data.region);
      allow update: if isManagerForRegion(docRegion(resource.data))
        && isManagerForRegion(request.resource.data.region);
    }
  }
}
